# CareCircle environment configuration.
# Copy to .env.local and fill in. Provider choices are swappable by env —
# no code change needed to move off a vendor.

# ---- Supabase (DB / auth / storage) ----------------------------------------
# Sovereign Edition: NEXT_PUBLIC_SUPABASE_URL MUST be the Chikasha Health OS
# project. care_circle.patient_id is the patient's auth uid in that project,
# so family authorization and access requests only resolve there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Point NEXT_PUBLIC_SUPABASE_URL at a self-hosted Supabase to drop the vendor,
# as long as the Health OS runs on that same instance.

# ---- Vault / MFA encryption (server-only, 32 bytes / 64 hex chars) ---------
VAULT_KEY_HEX=

# ---- App ----
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# ---- Chikasha Health OS (the patient data plane) ----
# Family pages read live vitals from {NEXT_PUBLIC_HEALTH_OS_URL}/api/shield/decrypt
# and post AI chat to {NEXT_PUBLIC_HEALTH_OS_URL}/api/shield with the member's JWT.
NEXT_PUBLIC_HEALTH_OS_URL=https://sovereignhealthcareos.com

# ============================================================================
# AI provider — LLM_PROVIDER selects the backend for /api/shield.
# ============================================================================
# "anthropic" (default): hosted Claude. Requires a BAA for PHI.
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-sonnet-4-20250514   # optional override
#
# "openai": ANY OpenAI-compatible /chat/completions endpoint — including a
# SELF-HOSTED local model (Ollama, vLLM, LM Studio, LocalAI), which removes
# the AI vendor entirely.
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
#   LLM_API_KEY=                              # optional; blank for most local servers
#   LLM_MODEL=llama3.1
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ============================================================================
# Email provider — EMAIL_PROVIDER selects the mailer.
# ============================================================================
# "resend" (default):
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=CareCircle <care@yourdomain>
# "http": POST {to,subject,html,from} to your own mailer (self-hosted relay,
#   SES shim, etc.) — no email vendor hard-wired.
#   EMAIL_PROVIDER=http
#   EMAIL_WEBHOOK_URL=https://mail.internal/send
#   EMAIL_WEBHOOK_TOKEN=            # optional bearer token
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ============================================================================
# SMS provider — SMS_PROVIDER selects the gateway.
# ============================================================================
# "twilio" (default):
#   TWILIO_ACCOUNT_SID=AC...
#   TWILIO_AUTH_TOKEN=...
#   TWILIO_FROM_NUMBER=+1...
# "http": POST {to,body} to your own gateway.
#   SMS_PROVIDER=http
#   SMS_WEBHOOK_URL=https://sms.internal/send
#   SMS_WEBHOOK_TOKEN=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Chikasha Health OS alert signing (HMAC over signed alert requests) ----------------
HEALTH_OS_ALERT_SIGNING_KEY=

# ============================================================================
# AI chat gate (Guided Answers)
# ============================================================================
# Two flags, deliberately separate. Both default to OFF when unset, so a
# deploy that forgets them falls back to the no-AI path rather than calling
# a model by accident.
#
# NEXT_PUBLIC_AI_CHAT_ENABLED picks which UI the chat tab renders. It is
# inlined into the browser bundle, so it is a UI switch only and cannot be
# trusted as a security control.
#   unset / anything else -> tab renders Guided Answers, tab label "Answers"
#   "true"                -> tab renders the LLM chat, tab label "Health OS"
NEXT_PUBLIC_AI_CHAT_ENABLED=

# AI_CHAT_ENABLED gates the server route /api/shield. Not NEXT_PUBLIC: this
# one is the actual control. When it is not "true" the route returns 404
# before auth, rate limiting, or any provider call, so a stale bundle or a
# direct request cannot reach the model.
AI_CHAT_ENABLED=
