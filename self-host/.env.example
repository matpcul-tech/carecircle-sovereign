# Self-hosted Supabase configuration for CareCircle.
# Copy to .env (same directory as docker-compose.yml) and fill in.
# Generate the secret values with:  node scripts/generate-keys.mjs

# ---- Secrets (generate; never commit) --------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- Database ----
POSTGRES_DB=postgres

# ---- Public URLs ----
# The externally reachable URL of THIS gateway (what the app and GoTrue use).
# Put TLS in front (see README) and use https in production.
API_EXTERNAL_URL=http://localhost:8000
# Your CareCircle app's origin (used for auth redirects / CORS allowlisting).
SITE_URL=http://localhost:3000
# Optional comma-separated extra redirect origins for GoTrue.
ADDITIONAL_REDIRECT_URLS=*

# ---- Gateway ----
GATEWAY_PORT=8000
