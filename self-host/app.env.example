# CareCircle app runtime secrets (server-only). Copy to app.env (gitignored).
# These are read by the app container at runtime - never baked into the image.
#
# NOTE: SUPABASE_SERVICE_ROLE_KEY and the NEXT_PUBLIC_* values are injected by
# docker-compose.app.yml from the stack's .env, so they are NOT repeated here.

# Document-vault + MFA-secret encryption key (64 hex chars).
# MUST stay the same across deploys or existing vault files / MFA secrets
# become undecryptable. Generate one with: node scripts/generate-keys.mjs
VAULT_KEY_HEX=

# ---- AI provider (see repo-root .env.example for the full matrix) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514
#
# …or drop the AI vendor and run a local model:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host
# LLM_MODEL=llama3.1

# ---- Email provider ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=CareCircle <care@yourdomain>
# …or your own mailer:
# EMAIL_PROVIDER=http
# EMAIL_WEBHOOK_URL=

# ---- SMS provider ----
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# …or your own gateway:
# SMS_PROVIDER=http
# SMS_WEBHOOK_URL=

# ---- CareIQ signed-alert HMAC key (must match the CareIQ side) ----
CAREIQ_ALERT_SIGNING_KEY=
